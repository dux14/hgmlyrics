# Frontend (Vite expone vars prefijadas con VITE_) — públicas, OK commitear este archivo.
VITE_SUPABASE_URL=https://omntufksfhezqtqgmhlp.supabase.co
VITE_SUPABASE_ANON_KEY=<paste-anon-key-from-supabase-dashboard>
# Google OAuth client ID (web) para "Guardar en Drive" del Estudio (público, no secreto)
VITE_GOOGLE_CLIENT_ID=

# Mundo virtual — WebRTC voz por zona (STUN es gratis; TURN es opcional para NAT simétrico)
# Si VITE_TURN_URL está vacío solo se usan los STUN públicos de Google.
# Formato: turn:<host>:<puerto>  o  turns:<host>:<puerto>  (TLS)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Backend (Vercel Functions) — no commitear valores reales en otros archivos.
SUPABASE_URL=https://omntufksfhezqtqgmhlp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<paste-service-role-key>
DATABASE_URL=<paste-postgres-connection-string>

# Admin gating — CSV de emails que se promueven a admin en cada login.
ADMIN_EMAILS=sduqueporras5@gmail.com

# Secreto para autorizar el cron de limpieza (Vercel inyecta el header Authorization: Bearer).
CRON_SECRET=<generar-token-aleatorio>
# Base pública del despliegue (para construir las URLs de webhook de Modal).
PUBLIC_BASE_URL=https://hgmlyrics.vercel.app

# Estudio de pistas — orquestador DAG en Modal.
# Endpoint del orquestador (app Modal publicada).
MODAL_STEMS_ENDPOINT=<url-del-endpoint-modal>
# Secreto de autorización de llamadas entrantes al orquestador.
MODAL_INBOUND_SECRET=<generar-token-aleatorio>
# Secreto para firmar/verificar los callbacks de sección que Modal postea al webhook.
# Sin este valor todos los callbacks fallan en silencio — requerido para arrancar jobs.
MODAL_WEBHOOK_SECRET=<generar-secreto-webhook-modal>

# Vista inmersiva karaoke — forced alignment (Demucs→WhisperX) en Modal.
# Endpoint del orquestador de alineado (reusa MODAL_INBOUND_SECRET para el auth entrante).
MODAL_ALIGN_ENDPOINT=<url-del-endpoint-modal>

# Partitura vocal — orquestador DAG en Modal (app hkn-pitch, run_pipeline).
# Endpoint del orquestador (app Modal publicada).
PITCH_MODAL_ENDPOINT=<url-del-endpoint-modal>
# Secreto de autorización de llamadas entrantes al orquestador (header x-inbound-secret).
PITCH_MODAL_INBOUND_SECRET=<generar-token-aleatorio>
# Secreto para firmar/verificar los callbacks que Modal postea a /api/pitch/webhook.
PITCH_MODAL_WEBHOOK_SECRET=<generar-secreto-webhook-modal>
